/**
 * העברת בעלות על 12 מושגים לעדי שמש ודנה חיות — חד-פעמי.
 *
 * הרקע: המושגים הוגשו על ידן במטלת 14.07.2026, אך הוזנו לאתר מראש
 * בזמן בניית הכלי ולכן נחסמו בפניהן. הסקריפט מחזיר להן את הקרדיט.
 *
 * מה הסקריפט עושה לכל אחד מ-12 המושגים:
 *   1. מחליף את ההגדרה בניסוח שלהן, כלשונו מהמטלה.
 *   2. מנקה את ההסבר המורחב והדוגמה — טקסט שנכתב על ידי אחרים
 *      ואין לייחסו להן.
 *   3. משנה את המגישות ל"עדי שמש, דנה חיות".
 *   4. מחזיר את הסטטוס ל"ממתין" ומנקה הערות, כדי שהמרצה יאשר מחדש.
 *
 * הרצה: הדביקו כקובץ נוסף בעורך Apps Script, בחרו transferToAdiDana ולחצו Run.
 *       אין צורך בפרסום מחדש (Deploy).
 *
 * מומלץ לגבות לפני: בגיליון → קובץ → יצירת עותק.
 * להרצה יבשה (דוח בלבד, בלי לשנות) — שנו ל-true:
 */
const TRANSFER_DRY_RUN = false;

const NEW_OWNER = 'עדי שמש, דנה חיות';

/** מזהה המושג באתר  →  ההגדרה כפי שנוסחה על ידן במטלה */
const ADI_DANA = {
  industry40:
    'המהפכה התעשייתית הרביעית מייצגת את המעבר מאוטומציה בסיסית של מכונות בודדות למערכות פיזיות דיגיטליות מקושרות המקבלות החלטה באופן עצמאי ובזמן אמת.',
  automation:
    'שימוש במכונות, מערכות או תוכנות לביצוע משימות ותהליכים באופן אוטומטי לפי כללים שהוגדרו מראש, במטרה לשפר יעילות, דיוק, איכות ובטיחות תוך צמצום ההתערבות האנושית.',
  autonomy:
    'היכולת של מערכת או מכונה לבצע משימות, לקבל החלטות ולהסתגל לשינויים בסביבה באופן עצמאי, תוך שימוש במידע מחיישנים ובאלגוריתמים וללא צורך בהתערבות אנושית מתמדת.',
  predictive:
    'גישה שבה מבצעים פעולות אחזקה מתוכננות מראש לציוד, למכונות ולמערכות לוגיסטיות, במטרה למנוע תקלות והשבתות לפני שהן מתרחשות. אחזקה מונעת מבטיחה רציפות תפעולית ומצמצמת עיכובים.',
  droneswarm:
    'קבוצה של רחפנים הפועלים בתיאום ובשיתוף פעולה לביצוע משימה משותפת, על בסיס אלגוריתמיקה, תקשורת ובינה מלאכותית, לשיפור היעילות, המהירות והגמישות.',
  disrupted:
    'מצב שבו הסביבה העסקית או התפעולית אינה יציבה וקיימים שיבושים בלתי צפויים המשפיעים על פעילות הארגון. סביבה המאופיינת בחוסר יציבות ובאירועים בלתי צפויים המשבשים את הפעילות השוטפת ומחייבים את הארגון להסתגל במהירות.',
  industry50:
    'תעשייה שחלקה בהווה וחלקה בעתיד. השלב הבא, הלוקח את הטכנולוגיה והאוטומציה לתפיסה הוליסטית המציבה את העובד האנושי, החוסן המבצעי והקיימות בליבת התפעול, ומדגיש את ממשק אדם-מכונה.',
  hmi:
    'מערכת המאפשרת תקשורת ואינטראקציה בין אדם למכונה, שבאמצעותה ניתן להפעיל את המערכת, לשלוט בתהליכים, להזין פקודות, לקבל מידע ומשוב בזמן אמת ולבצע בקרה באופן יעיל, בטוח ונוח.',
  radioshuttle:
    'רכב אוטומטי הנע בתוך תעלות אחסון ומבצע אחסון ושליפה של משטחים באופן עצמאי, במטרה לשפר את ניצול שטח המחסן, להגדיל את מהירות העבודה ולהפחית טעויות ונזקים.',
  pickbylight:
    'שיטת ליקוט המשתמשת בנורות ובתצוגות על המדפים כדי להנחות את העובד למיקום הפריט ולכמות שיש לאסוף, ובכך משפרת את מהירות הליקוט ואת דיוקו.',
  pickbyvoice:
    'שיטת ליקוט שבה העובד מקבל הוראות קוליות באמצעות אוזנייה ומאשר את ביצוע הליקוט בקול, מה שמאפשר עבודה מהירה ומדויקת ללא שימוש בידיים.',
  pickbyvision:
    'שיטת ליקוט שבה משתמשים במשקפיים חכמים המציגים לעובד באופן חזותי את מיקום הפריט, הכמות והוראות הליקוט, ובכך משפרת את הדיוק והיעילות.'
};

function transferToAdiDana() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('terms');
  if (!sh) throw new Error('לא נמצא גיליון terms');

  const data = sh.getDataRange().getValues();
  const head = data[0];
  const col = {};
  ['id', 'short', 'long', 'ex', 'status', 'addedBy', 'note', 'timestamp']
    .forEach(function (k) { col[k] = head.indexOf(k); });
  if (col.id === -1 || col.short === -1) throw new Error('חסרות עמודות id/short');

  const done = [], missing = [];
  const handled = {};

  for (let i = 1; i < data.length; i++) {
    const id = String(data[i][col.id]).trim();
    if (!ADI_DANA.hasOwnProperty(id) || handled[id]) continue;
    handled[id] = true;
    const row = i + 1;

    if (!TRANSFER_DRY_RUN) {
      sh.getRange(row, col.short + 1).setValue(ADI_DANA[id]);
      if (col.long !== -1) sh.getRange(row, col.long + 1).setValue('');
      if (col.ex !== -1) sh.getRange(row, col.ex + 1).setValue('');
      if (col.addedBy !== -1) sh.getRange(row, col.addedBy + 1).setValue(NEW_OWNER);
      if (col.note !== -1) sh.getRange(row, col.note + 1).setValue('');
      if (col.status !== -1) sh.getRange(row, col.status + 1).setValue('ממתין');
      if (col.timestamp !== -1) sh.getRange(row, col.timestamp + 1).setValue(new Date());
    }
    done.push(id + ' (שורה ' + row + ')');
  }

  Object.keys(ADI_DANA).forEach(function (id) {
    if (!handled[id]) missing.push(id);
  });

  const msg = (TRANSFER_DRY_RUN ? '— הרצה יבשה, לא שונה דבר —\n' : '') +
    'הועברו לעדי שמש ודנה חיות והוחזרו ל"ממתין": ' + done.length + '\n' +
    done.join('\n') +
    (missing.length ? '\n\nלא נמצאו בגיליון: ' + missing.join(', ') : '');
  Logger.log(msg);
  return msg;   // מוצג ב-Execution log
}
